# Orrery web. Copy to .env.local. Values marked "placeholder" must be real before a deploy.

# Chain and API (safe defaults: 4663 and its public RPC; no API means the pages show their forward state)
NEXT_PUBLIC_CHAIN_ID=4663
NEXT_PUBLIC_RPC_URL=https://rpc-robinhood.blockmachine.io
# RPC written into an agent's key file (the agent sends its own top-ups, so it must publish transactions). Unset: a
# public endpoint that does on 4663, the page's RPC elsewhere.
NEXT_PUBLIC_AGENT_RPC_URL=
# placeholder: the check service URL
NEXT_PUBLIC_API_URL=

# v1 contracts (placeholders: real deployment addresses)
NEXT_PUBLIC_MODULE=
NEXT_PUBLIC_ATTESTOR=
NEXT_PUBLIC_LENS=
NEXT_PUBLIC_REGISTRY=

# ORRY release switch fallback, used only while GET /v1/releases cannot be reached: comma list of earn, stake,
# agent-stake, claim, burn, leaderboard, checkout, payg-checks, stocks, swap, darkpool, facilitator, merchant-badge.
# Unset or empty: everything held.
NEXT_PUBLIC_ORRY_FEATURES=

# ORRY contracts (placeholders: real deployment addresses). A feature whose contracts are missing shows "Coming soon".
NEXT_PUBLIC_ORRY_TOKEN=
# Earn vault factory: lists one Earn vault per ORRY pool (ETH, USDG, ...).
NEXT_PUBLIC_ORRY_EARN_FACTORY=
NEXT_PUBLIC_ORRY_STAKING=
NEXT_PUBLIC_ORRY_CLAIM_ALL=
NEXT_PUBLIC_ORRY_REWARDS_ROUTER=
NEXT_PUBLIC_ORRY_TREASURY=

# Wave R1 markets (placeholder: the market factory from deployments/markets-4663.json)
NEXT_PUBLIC_MARKET_FACTORY=
# Wave 3 merchant payments (placeholder: the splitter factory from deployments/facilitator-4663.json)
NEXT_PUBLIC_SPLITTER_FACTORY=

# ORRY contract address for the hero's CA pill. Server side (no NEXT_PUBLIC_ prefix): /api/ca reads it per request, so
# changing it needs no code change. Unset or not a valid address: the pill is hidden. Mainnet (Vercel production):
# 0x85272EA3aE8685C768045dba5455fE305C706aA4. Leave empty on the development network.
ORRERY_CA=
# Where ORRY trades, for the buttons beside the CA pill. Server side, read per request. Empty (the safe default): the
# token's Pons launch page. To replace the list: Name|https://url,Name|https://url with {ca} for the token address.
ORRERY_TRADE_LINKS=

# Explorer for transaction links (default on 4663: Blockscout)
NEXT_PUBLIC_EXPLORER_URL=
# Lane L5, Agent Launch: AgentLaunch and its SpokeRouter (no defaults; the pages read "Coming soon" without them)
NEXT_PUBLIC_AGENT_LAUNCH=
NEXT_PUBLIC_SPOKE_ROUTER=

# Social links in the nav, footer, Terms and Privacy. Empty (the default): the link is not rendered. Set only to a real
# Orrery account: the X handle with or without "@", and a full https:// Discord invite URL.
NEXT_PUBLIC_X_HANDLE=
NEXT_PUBLIC_DISCORD_URL=
