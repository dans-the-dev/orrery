{
  "$comment": "Orrery on Robinhood Chain 4663, server 1 uptime monitor (2026-11-09). Stage prelaunch: the web, the Discord process and the daily database dump. Stage launch (after the v1 deploy brings up the API, indexer and prober and the relayer and attester hold gas): also the API health, the release switch, the indexer lag against the chain head, the prober, and relayer and attester gas. Stage orry (after the ORRY deploy starts the keeper): also the keeper, its last pass and its gas. Gas floors match ORRERY_DISCORD_WATCH. Switch with: sed -i 's/\"stage\": \"prelaunch\"/\"stage\": \"launch\"/' targets.json (later launch to orry).",
  "stage": "prelaunch",
  "stages": ["prelaunch", "launch", "orry"],
  "networks": {
    "mainnet": {
      "web": "https://orrery.tech",
      "api": "https://api.orrery.tech"
    }
  },
  "rpc": ["https://rpc.mainnet.chain.robinhood.com", "https://rpc-robinhood.blockmachine.io"],
  "probe": {
    "file": "./probe/host.json",
    "maxAgeSec": 600,
    "indexerHealth": "http://127.0.0.1:18788/",
    "backupDir": "/opt/orrery/backups",
    "keeperContainer": "orrery-keeper"
  },
  "checks": [
    { "name": "web /", "base": "web", "path": "/", "contains": "orrery" },
    { "name": "web /discord/verify", "base": "web", "path": "/discord/verify", "contains": "Verify your wallet." },
    { "name": "discord container", "container": "orrery-discord", "minUpSeconds": 120 },
    { "name": "database backup", "backup": { "maxAgeHours": 26 } },
    { "name": "api /health", "from": "launch", "base": "api", "path": "/health", "json": { "ok": true, "chainId": 4663 } },
    {
      "name": "api /v1/releases",
      "from": "launch",
      "base": "api",
      "path": "/v1/releases",
      "json": { "serverTime": { "notNull": true }, "releases": { "notNull": true } }
    },
    { "name": "indexer lag", "from": "launch", "indexer": { "maxLag": 600, "orryExtra": 10 } },
    { "name": "prober container", "from": "launch", "container": "orrery-prober", "minUpSeconds": 120 },
    { "name": "relayer gas", "from": "launch", "balance": { "address": "0x21f7536E49Ffc5CbfFd7b976A0c73f3A0BC2C6C0", "minEth": "0.0001" } },
    { "name": "attester gas", "from": "launch", "balance": { "address": "0xe0444a010EbAdb445aD75629E20c4C0149724eC0", "minEth": "0.0001" } },
    { "name": "keeper container", "from": "orry", "container": "orrery-keeper", "minUpSeconds": 120 },
    { "name": "keeper last pass", "from": "orry", "keeperPass": { "maxAgeMinutes": 75 } },
    { "name": "keeper gas", "from": "orry", "balance": { "address": "0x1241C83501E865c86613c715bE40A60Be455075F", "minEth": "0.001" } }
  ]
}
