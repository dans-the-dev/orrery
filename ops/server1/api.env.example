# API only. Copy to api.env (mode 600).
ORRERY_CORS_ORIGINS=https://orrery.tech,https://www.orrery.tech
ORRERY_QUOTE_SIGNER_KEY_FILE=/run/keys/quote-signer.json
# Shared Caddy on the private Docker network is trusted for X-Forwarded-For (default loopback, link-local, private ranges).
ORRERY_TRUST_PROXY=loopback,linklocal,uniquelocal
