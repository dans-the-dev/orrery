# Orrery on 4663, shared by every service. Copy to common.env (mode 600) on server 1; addresses come from
# deployments/4663.json and deployments/orry-4663.json after the deploy scripts run.
ORRERY_CHAIN_ID=4663
# Free official RPC first, keyless fallback second (measured 2026-11-09 from server 1: 10,000-block eth_getLogs ok on the
# official endpoint; the fallback serves the most recent 5,000 blocks, enough once the indexer is at the head).
ORRERY_RPC_URL=https://rpc.mainnet.chain.robinhood.com,https://rpc-robinhood.blockmachine.io
# The password matches /opt/orrery/secrets/pg-password.
ORRERY_DATABASE_URL=postgres://orrery:<pg-password>@orrery-pg:5432/orrery
ORRERY_PUBLIC_URL=https://api.orrery.tech
ORRERY_CONFIRMATIONS=10
# v1 (deploy-4663.ts prints these)
ORRERY_MODULE=
ORRERY_ATTESTOR=
ORRERY_LENS=
ORRERY_REGISTRY=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
ORRERY_USDG=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
ORRERY_TREASURY=
ORRERY_INDEXER_START_BLOCK=
# Key files (mounted read-only by compose; each service mounts only its own)
ORRERY_RELAYER_KEY_FILE=/run/keys/relayer.json
ORRERY_CHECK_SIGNER_KEY_FILE=/run/keys/check-signer.json
ORRERY_ATTESTER_KEY_FILE=/run/keys/attester.json
# ORRY (deploy-orry-4663.ts prints these; leave ORRERY_ORRY_TOKEN empty until ORRY is deployed)
# The token is live on Pons since 2026-11-10: 0x85272EA3aE8685C768045dba5455fE305C706aA4. It goes here together with the eight addresses
# deploy-orry-4663.ts prints after graduation, never alone (alone it fails the config check).
ORRERY_ORRY_TOKEN=
ORRERY_ORRY_HOOK=
ORRERY_ORRY_EARN_FACTORY=
ORRERY_ORRY_STAKING=
ORRERY_ORRY_ROUTER=
ORRERY_ORRY_BUYBACK=
ORRERY_ORRY_LENS=
ORRERY_ORRY_CLAIM_ALL=
ORRERY_ORRY_START_BLOCK=
