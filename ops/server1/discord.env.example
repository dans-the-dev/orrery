# Discord bot (stage 1 notifier and stage 2 interactions). Copy to discord.env (mode 600).
ORRERY_DISCORD_TOKEN_FILE=/run/keys/discord-bot.txt
ORRERY_DISCORD_GUILD=1569204585011220480
ORRERY_DISCORD_APP_ID=1569247955108630598
# Application public key from the Developer Portal (public, used to check Discord's request signatures)
ORRERY_DISCORD_PUBLIC_KEY=8405480072b67e21bcd96b05bfa7019894b0b0c886e87ce18bda7111e182531d
ORRERY_WEB_URL=https://orrery.tech
# Wallets the #alerts channel watches: name=address:minimum ETH
ORRERY_DISCORD_WATCH=relayer=0x21f7536E49Ffc5CbfFd7b976A0c73f3A0BC2C6C0:0.0001,attester=0xe0444a010EbAdb445aD75629E20c4C0149724eC0:0.0001,keeper=0x1241C83501E865c86613c715bE40A60Be455075F:0.001
# Release cards reviewed by the owner (copy ops/discord/cards/*.png and captions.json to /opt/orrery/cards)
ORRERY_DISCORD_CARDS_DIR=/run/cards
# Drafts reach #release-drafts this many minutes before a release opens; /announce posts them after review
ORRERY_DISCORD_DRAFT_LEAD_MIN=60
