# /etc/systemd/system/orrery-pg-backup.timer
# Daily at 03:47 UTC (clear of the other backups on server 1 at 02:41 and 03:10). Persistent: a run missed while the
# server was down happens at the next boot.
[Unit]
Description=Daily: Orrery database dump

[Timer]
OnCalendar=*-*-* 03:47:00 UTC
RandomizedDelaySec=300
Persistent=true

[Install]
WantedBy=timers.target
