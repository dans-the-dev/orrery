# Support replies (#reply-queue). Copy to support.env (mode 600). The process also reads common.env and discord.env.
# Keys live in /opt/orrery/secrets/support/ (dir 700, files 600, owner uid 1000):
#   anthropic.env  ANTHROPIC_API_KEY=...                                        required
#   x-api.json     {"apiKey","apiSecret","accessToken","accessSecret"}          optional; for the Orrery X account, without it X is off
# release.env needs SUPPORT_TAG=<commit> (the image this service runs); TAG stays for every other service.
#
# Model that drafts the replies
ORRERY_SUPPORT_MODEL=claude-opus-5-5
# Draft categories sent without approval (owner, 2026-11-11); empty sends nothing automatically
ORRERY_SUPPORT_AUTO=faq,greeting
# Automatic replies per rolling day (Discord and X together), and per author per rolling hour
ORRERY_SUPPORT_AUTO_MAX_DAY=40
ORRERY_SUPPORT_AUTO_MAX_AUTHOR_HOUR=3
# Drafts per rolling day, a ceiling on model spend
ORRERY_SUPPORT_MAX_DRAFTS_DAY=300
# How often X mentions are read (each mention read is billed)
ORRERY_SUPPORT_X_EVERY_MS=300000
# Where the knowledge base reads live pricing and feature status
ORRERY_SUPPORT_API_URL=https://api.orrery.tech
# Server nickname the bot shows (owner, 2026-11-11); empty leaves it unchanged
ORRERY_SUPPORT_NICK=Orrery Team
